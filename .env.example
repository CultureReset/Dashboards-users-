# Copy to .env.local and edit. Every value has a working default in
# src/lib/config.js, so a plain checkout already points at the live GCR stack —
# these are only needed to point somewhere else.

# gcr-api-clean. Local API: http://localhost:3000
#
# This is the only host the app talks to. There used to be a Supabase URL and
# an anon key here as well; both are gone, because the browser no longer opens
# the database. If a change wants them back, the change is the wrong one.
VITE_GCR_API_BASE=https://gcr-api-clean.vercel.app

# Businesses type their slug; it maps to <slug>@<this domain> for Auth.
# Must match the --domain used by scripts/provision-accounts.mjs, and
# BUSINESS_LOGIN_DOMAIN in gcr-api-clean.
VITE_LOGIN_DOMAIN=biz.gulfcoastradar.com

# How long a single API call may take before it is abandoned, in milliseconds.
VITE_REQUEST_TIMEOUT_MS=30000

# The service_role key is never a VITE_ variable — anything prefixed VITE_ is
# compiled into the browser bundle. scripts/ read it from SUPABASE_SERVICE_KEY
# in the shell at run time, and the app itself never reads it at all.
